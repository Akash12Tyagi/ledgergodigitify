# Copy to .env.local for development. Never commit real values (Section 2.4 / 10.12).
# In production these are set via `vercel env add` (Section 17.1) — never in a file.

# MongoDB Atlas connection string, must start with mongodb / mongodb+srv
MONGODB_URI=mongodb://127.0.0.1:27017/finance

# Better Auth — generate once with: openssl rand -base64 48
# NEVER rotate casually; rotating invalidates every session (Section 11 / 18.1).
BETTER_AUTH_SECRET=

# Must equal, scheme included, the URL users actually visit.
BETTER_AUTH_URL=http://localhost:3000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Bearer token required by /api/cron/*. Generate with: openssl rand -base64 48
CRON_SECRET=

APP_TIMEZONE=Asia/Kolkata

# Used only by scripts/bootstrap-owner.ts (Section 6.10 / 17.3) — never committed.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_NAME=
